           random_switch-timer
           alternating_procedure_val
           fov-list-alphas-same1
           fov-list-alphas-same2
           fov-list-alphas-other1
           fov-list-alphas-other2
           caught-flag
           t_s
           detection_flag
           omega_val
           omega
           wait_flag
           true_velocity
           V
           dist-to-closest
           my-dist-to-closest-std
           fov-list-betas
          ]

centroids-own
          [
            cc-rad
            ic-rad
          ]

patches-own [
            real-bearing-patch
            closest-alpha-dist
          ]

discs-own [
            age
          ]
place-holders-own [
                    species
                  ]





;;
;; Setup Procedures
;;
to setup
  clear-all
  random-seed seed-no


  set tick-delta 0.025 ; 10 ticks in one second

  let gr (range  (min-pxcor + 3) (max-pxcor - 3) 1)
  set circle1size 1
  set circle2size 1

  set rand-xcor one-of gr
  set rand-ycor one-of gr

  while [rand-ycor < (- rand-xcor )]
    [
      set rand-xcor one-of gr
     set rand-ycor one-of gr
    ]

  initialize_lists

  ask patches
    [
       set pcolor white
    ]




  set n number-of-alphas

  while [n > 0]
  [
   make_alpha
   set n (n - 1)
  ]

    ; adds extra "ghost" turtles that make adding and removing agents during simulation a bit easier
  create-place-holders 20
  [
    setxy max-pxcor max-pycor
    ht
    set species "alpha"
  ]
  
  if add_leader?
  [
  make_beta
  ]

   alpha_setup_strict
  

 create-centroids 1
  [ 
    setxy 0 0
    set size 1
    set color violet
    set shape "circle"
    set cc-rad 3
    set ic-rad 1
    ht
   ]


  set-default-shape discs "ring"

  reset-ticks
end

to initialize_lists

  set circliness_list (list )
  set rad_var_list (list )
  set group-rot_list (list )
  set ang-momentum_list (list )
  set scatter_list (list )
  set radius_list (list )
  set diffusion_list (list)
  set diffusion_opp_list (list)

  set outer_radius_size_list (list )
  set circliness_list_list (list )
  set alg-con_list (list )
  set num-of-groups_list (list )
  set group-stability_list (list )
  set v_avg_list (list )


  set DM matrix:make-constant number-of-alphas number-of-alphas 0
  set AM matrix:make-constant number-of-alphas number-of-alphas 0
  set GM matrix:make-constant number-of-alphas number-of-alphas number-of-alphas

end

;;
;; Runtime Procedures
;;
to go
  
  background_procedures ; for general functions like showing FOV

 ask centroids
   [ 
     update_centroid
     ht 
   ]

 ask alphas
    [
        ifelse can_detect_alphas?
        [
          set detect_alphas? true
        ]
        [
          set detect_alphas? false
         set fov-list-alphas_left (list )
         set fov-list-alphas_right (list )
         set fov-list-alphas (list )
      
        ]
        set detect_betas? true
        
        
         alpha_procedure_split 
        
      ]

  ask betas 
  [
   beta-manual-drive 
  ]

;  classify_behavior
  
  find-metrics

  if end_flag = 1
  [
    stop

  ]


  if combined_stability_val > 3000
  [
    set end_flag  1

  ]


  tick-advance 1
end

to beta-manual-drive 
  update_agent_state; updates states of agents (i.e. position and heading)
  
end



to update_centroid ; only analyzes alphas, not betas
  let minx (min [xcor] of alphas) 
  let maxx (max [xcor] of alphas)

  let miny (min [ycor] of alphas)
  let maxy (max [ycor] of alphas)

  let centerx mean [xcor] of alphas
  let centery mean [ycor] of alphas

  setxy centerx centery

  set cc-rad ([distance myself] of max-one-of alphas [distance myself])
  set ic-rad ([distance myself] of min-one-of alphas [distance myself])

end


;to alpha_procedure
;  do_sensing ; does the sensing to detect whatever the alpha is set to detec
;
;
;  ifelse length fov-list-betas > 0 or length fov-list-alphas > 0 ; if they detect anything they set their detection flag to 1
;  [
;    set detection_flag 1
;  ]
;  [
;    set detection_flag 0
;  ]
;
;
;  ifelse detection_flag = 1
;  [
;    set inputs (list alpha-speed-2 90 alpha-turning-rate-2)
;    set color green
;  ]
;  [
;    set inputs (list alpha-speed-1 90 alpha-turning-rate-1)
;    set color blue
;  ]
;
; update_agent_state; updates states of agents (i.e. position and heading)
;
;
;end

to alpha_procedure_split
  do_sensing ; does the sensing to detect whatever the alpha is set to detec


  ifelse length fov-list-alphas_right > 0 ; if they detect anything on the right side of the fov they set their detection flag to 1
  [
    set detection_flag_right 1
  ]
  [
    set detection_flag_right 0
  ]
  
  ifelse length fov-list-alphas_left > 0 ; if they detect anything on the left side of the fov they set their detection flag to 1
  [
    set detection_flag_left 1
  ]
  [
    set detection_flag_left 0
  ]
  
  ifelse length fov-list-betas > 0 ; 
  [
    set detection_flag_beta 1
  ]
  [
    set detection_flag_beta 0
  ]

  ifelse length fov-list-alphas > 0 ; if they detect anything they set their detection flag to 1
  [
    set detection_flag 1
  ]
  [
    set detection_flag 0
  ]
  let alpha_flag 0
  
  
  
  (ifelse detect_alpha_region = "Left Half"
    [
      set alpha_flag detection_flag_left 
    ]
    detect_alpha_region = "Right Half"
    [
      set alpha_flag detection_flag_right
    ]
    [
      set alpha_flag detection_flag
    ]
    )
    
  

    (ifelse detection_flag_beta = 1 ;or detection_flag = 1
    [
      set inputs (list alpha-speed-3 90 alpha-turning-rate-3)
      set color red
    ]
    alpha_flag = 1
    [
      set inputs (list alpha-speed-2 90 alpha-turning-rate-2)
      set color green
    ]
    [
      set inputs (list alpha-speed-1 90 alpha-turning-rate-1)
      set color blue
    ])  
  
  if stop_alphas?
  [
    set inputs (list 0 90 0)
  ]
  
;  (ifelse detection_flag_beta = 1 ;or detection_flag = 1
;  [
;    set inputs (list alpha-speed-3 90 alpha-turning-rate-3)
;    set color red
;  ]
;  [
;    set inputs (list alpha-speed-1 90 alpha-turning-rate-1)
;    set color blue
;  ])


 update_agent_state; updates states of agents (i.e. position and heading)


end



to background_procedures
 clear-paint

ifelse paint_fov?
  [
    ask discs
      [
         set age age + 1
         if age = 1 [ die ]
       ]

    ask alphas
      [
        (ifelse vision-cone-alpha = 360
          [
            hatch-discs 1
                [
                  set size 2 * (vision-distance-alpha * 1)
                  set heading ([heading] of myself + FOV-offset)
                  palette:set-transparency 50
                ]
          ]
          vision-cone-alpha = 270
          [
            hatch-discs 1
                [
                  set size 2 * (vision-distance-alpha * 1)
                  set heading ([heading] of myself + FOV-offset)
                  set shape "270-deg-fov"
                  palette:set-transparency 50
                ]
          ]
          vision-cone-alpha = 180
          [
            hatch-discs 1
                [
                  set size 2 * (vision-distance-alpha * 1)
                  set heading ([heading] of myself + FOV-offset)
                  set shape "180-deg-fov"
                  palette:set-transparency 50
                ]
          ]
          vision-cone-alpha = 135
          [
            hatch-discs 1
                [
                  set size 2 * (vision-distance-alpha * 1)
                  set heading ([heading] of myself + FOV-offset)
                  set shape "135-deg-fov"
                  palette:set-transparency 50
                ]
          ]
          vision-cone-alpha = 90
          [
            hatch-discs 1
                [
                  set size 2 * (vision-distance-alpha * 1)
                  set heading ([heading] of myself + FOV-offset)
                  set shape "90-deg-fov"
                  palette:set-transparency 50
                ]
          ]
          vision-cone-alpha = 45
          [
            hatch-discs 1
                [
                  set size 2 * (vision-distance-alpha * 1)
                  set heading ([heading] of myself + FOV-offset)
                  set shape "45-deg-fov"
                  palette:set-transparency 50
                ]
          ]
          vision-cone-alpha = 55
          [
            hatch-discs 1
                [
                  set size 2 * (vision-distance-alpha * 1)
                  set heading ([heading] of myself + FOV-offset)
                  set shape "55-deg-fov"
                  palette:set-transparency 50
                ]
          ]
          vision-cone-alpha = 60
          [
            hatch-discs 1
                [
                  set size 2 * (vision-distance-alpha * 1)
                  set heading ([heading] of myself + FOV-offset)
                  set shape "60-deg-fov"
                  palette:set-transparency 50
                ]
          ]
          vision-cone-alpha = 30
          [
            hatch-discs 1
                [
                  set size 2 * (vision-distance-alpha * 1)
                  set heading ([heading] of myself + FOV-offset)
                  set shape "30-deg-fov"
                  palette:set-transparency 50
                ]
          ]
          [
            paint-patches-in-new-FOV
          ]
          )

      ]
  ]
  [
    ask discs [die]
  ]

  ifelse draw_path?
  [
    ask alphas [pd]
  ]
  [
    ask alphas [pu]
  ]
end

to find-metrics

  ask alphas
  [ ;find_resultant_angle
    set V sqrt (((item 0 velocity + impact-x)^ 2) + ((item 1 velocity + impact-y)^ 2))



    set scatter_indiv ((xcor - mean[xcor] of centroids) ^ 2 + (ycor - mean [ycor] of centroids ) ^ 2)

    set rad_var_comp1 sqrt(scatter_indiv)
    set rad_var_comp1_sum rad_var_comp1_sum + rad_var_comp1
    set rad_var_comp2 (rad_var_comp1 - rad_var_comp1_mean_sub) ^ 2

    set dist-to-closest distance min-one-of other alphas [distance myself]
    set dist-to-furthest distance max-one-of other alphas [distance myself]

    set my-dist-to-closest-std (dist-to-closest - dist-to-closest-avg)^ 2
    set my-dist-to-furthest-std (dist-to-furthest - dist-to-furthest-avg)^ 2



    set momentum_indiv  (((item 0 velocity + impact-x) * (ycor - mean [ycor] of centroids)) - ((item 1 velocity + impact-y)* (xcor - mean [xcor] of centroids )))

    set rot_indiv  (((item 0 velocity + impact-x) * ((ycor - mean [ycor] of centroids) / sqrt((xcor - mean [xcor] of centroids) ^ 2 + (ycor - mean [ycor] of centroids) ^ 2))) - ((item 1 velocity + impact-y) * ((xcor - mean [xcor] of centroids) / sqrt((xcor - mean [xcor] of centroids) ^ 2 + (ycor - mean [ycor] of centroids) ^ 2))))



    set V-sum V-sum + V
    set scatter-sum scatter-sum + scatter_indiv
    set momentum-sum momentum-sum + momentum_indiv
    set group-rot-sum group-rot-sum + rot_indiv
    set rad_var_comp_sum rad_var_comp_sum + rad_var_comp2
    set dist-to-closest-sum dist-to-closest-sum + dist-to-closest
    set dist-to-closest-std-sum dist-to-closest-std-sum + my-dist-to-closest-std
    set dist-to-furthest-sum dist-to-furthest-sum + dist-to-furthest
    set dist-to-furthest-std-sum dist-to-furthest-std-sum + my-dist-to-furthest-std


   ]



   set avg-speeds (V-sum / number-of-alphas)
   set scatter (scatter-sum / (number-of-alphas)); * (sqrt(2)* max-pxcor) ^ 2))
   set ang-momentum (momentum-sum / (number-of-alphas)); * (sqrt(2)* max-pxcor)))
   set group-rot (group-rot-sum / number-of-alphas)
   set circliness (mean[cc-rad] of centroids - mean [ic-rad] of centroids )/ mean [ic-rad] of centroids

   set dist-to-closest-avg (dist-to-closest-sum / number-of-alphas)
   set dist-to-closest-standard-dev ( dist-to-closest-std-sum / number-of-alphas)

  set dist-to-furthest-avg (dist-to-furthest-sum / number-of-alphas)
   set dist-to-furthest-standard-dev ( dist-to-furthest-std-sum / number-of-alphas)


;  set diffusion_val 1 - exp(dist-to-closest-standard-dev / dist-to-closest-avg)
   set diffusion_val dist-to-closest-standard-dev
  set diffusion_opp_val dist-to-furthest-standard-dev

   set outer_radius_size (mean [cc-rad] of centroids )
   set rad_var_comp1_mean (rad_var_comp1_sum / number-of-alphas)
   set rad_var_comp1_mean_sub rad_var_comp1_mean

   set rad_var (rad_var_comp_sum / (number-of-alphas)); * (sqrt(2)* max-pxcor) ^ 2))


   set V-sum 0
   set scatter-sum 0
   set momentum-sum 0
   set group-rot-sum 0
   set rad_var_comp_sum 0
   set rad_var_comp1_sum 0
   set dist-to-closest-sum 0
   set dist-to-closest-std-sum 0
   set dist-to-furthest-sum 0
   set dist-to-furthest-std-sum 0

  ifelse length diffusion_list > 1000
    [
     set diffusion_list remove-item 0 diffusion_list
     set diffusion_list lput diffusion_val diffusion_list
     ]
    [
      set diffusion_list lput diffusion_val diffusion_list
    ]

  ifelse length diffusion_opp_list > 1000
    [
     set diffusion_opp_list remove-item 0 diffusion_opp_list
     set diffusion_opp_list lput diffusion_opp_val diffusion_opp_list
     ]
    [
      set diffusion_opp_list lput diffusion_opp_val diffusion_opp_list
    ]


   ifelse length v_avg_list > 1000
    [
     set v_avg_list remove-item 0 v_avg_list
     set v_avg_list lput avg-speeds v_avg_list
     ]
    [
      set v_avg_list lput avg-speeds v_avg_list
    ]

   ifelse length scatter_list > 1000
    [
     set scatter_list remove-item 0 scatter_list
     set scatter_list lput scatter scatter_list
     ]
    [
      set scatter_list lput scatter scatter_list
    ]

  ifelse length group-rot_list > 1000
    [
     set group-rot_list remove-item 0 group-rot_list
     set group-rot_list lput group-rot group-rot_list
     ]
    [
      set group-rot_list lput group-rot group-rot_list
    ]

  ifelse length ang-momentum_list > 1000
    [
     set ang-momentum_list remove-item 0 ang-momentum_list
     set ang-momentum_list lput ang-momentum ang-momentum_list
     ]
    [
      set ang-momentum_list lput ang-momentum ang-momentum_list
    ]

  ifelse length rad_var_list > 1000
    [
     set rad_var_list remove-item 0 rad_var_list
     set rad_var_list lput rad_var rad_var_list
     ]
    [
      set rad_var_list lput rad_var rad_var_list
    ]

  ifelse length circliness_list > 300
    [
     set circliness_list remove-item 0 circliness_list
     set circliness_list lput circliness circliness_list
     ]
    [
      set circliness_list lput circliness circliness_list
    ]

  ifelse length alg-con_list > 300
    [
     set alg-con_list remove-item 0 alg-con_list
     set alg-con_list lput alg-con alg-con_list
     ]
    [
      set alg-con_list lput alg-con alg-con_list
    ]



   let current_radius mean[cc-rad] of centroids



  ifelse length radius_list > 300
    [
     set radius_list remove-item 0 radius_list
     set radius_list lput current_radius radius_list
     ]
    [
      set radius_list lput current_radius radius_list
    ]

   ifelse current_radius > (old_radius * 1.05);if the moving average window increases, it is growing
     [
       set growth_val growth_val + 1
     ]
     [
       set growth_val 0
     ]

   ifelse current_radius < (old_radius * 0.95);if the moving average window decreases, it is shrinking
     [
       set shrink_val shrink_val + 1
     ]
     [
       set shrink_val 0
     ]


   if ticks mod 1000 = 0
     [
      set old_radius mean radius_list
      ]

end

